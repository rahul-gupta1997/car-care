# Public configuration only. Never add secrets here.
# Mock adapters are enabled only in development (or Jest).
EXPO_PUBLIC_USE_MOCK_API=true
# Set after agreeing the backend contract; no production endpoint is assumed.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_TIMEOUT_MS=15000
# Optional public Sentry DSN; authentication tokens belong in CI secrets.
EXPO_PUBLIC_SENTRY_DSN=
