{
  "expo": {
    "name": "Car Care",
    "slug": "car-care",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/app-icon.png",
    "scheme": "carcare",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.carcare.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#103C46",
        "foregroundImage": "./assets/icons/adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.carcare.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/car-care-mark.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#103C46",
          "image": "./assets/icons/adaptive-foreground.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#0B171F"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
